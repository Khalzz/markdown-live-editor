{
  "name": "markdown-live-editor",
  "version": "0.1.3",
  "description": "A live, WYSIWYG-style markdown editor built on Tiptap/ProseMirror — real block elements instead of a plain-text buffer with syntax hidden/revealed via decorations. Ships no embeds of its own; bring your own Tiptap node extensions.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-bold": "^3.28.0",
    "@tiptap/extension-bubble-menu": "^3.28.0",
    "@tiptap/extension-code": "^3.28.0",
    "@tiptap/extension-heading": "^3.28.0",
    "@tiptap/extension-italic": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/suggestion": "^3.28.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.42.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-bold": "^3.28.0",
    "@tiptap/extension-bubble-menu": "^3.28.0",
    "@tiptap/extension-code": "^3.28.0",
    "@tiptap/extension-heading": "^3.28.0",
    "@tiptap/extension-italic": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-text-align": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/suggestion": "^3.28.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "lucide-react": "^1.14.0",
    "motion": "^12.42.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
